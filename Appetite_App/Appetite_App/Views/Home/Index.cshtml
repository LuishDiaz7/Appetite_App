@model IEnumerable<Appetite_App.Models.Categoria>

@{
    ViewData["Title"] = "Menú Principal";
}

<div class="jumbotron jumbotron-fluid text-center p-5 mb-4" style="background-color: #f7f7f7;">
    <h1 class="display-5 font-weight-bold" style="color: #FF6347;">¡Bienvenido a Appetite!</h1>
    <p class="lead text-muted">Comienza tu orden seleccionando una categoría.</p>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        @foreach (var categoria in Model)
        {
            <div class="col-auto p-1">
                <a asp-controller="Productos"
                   asp-action="Categoria"
                   asp-route-id="@categoria.IdCategoria" class="btn btn-outline-danger btn-lg rounded-pill"
                   style="min-width: 150px;">
                    @categoria.Nombre
                </a>
            </div>
        }
    </div>
</div>

<div class="container">
    <h2 class="text-center mt-5" style="color: #333;">@ViewData["CategoriaSeleccionada"]</h2>
</div>
