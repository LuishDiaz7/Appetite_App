@model IEnumerable<Appetite_App.Models.Producto>

@{
    ViewData["Title"] = "Menú Principal";
}

<div class="container mt-5">
    <h1 class="display-4 text-center mb-3">Catálogo Appetite</h1>
    <p class="lead text-center text-muted">Selecciona un producto y sus extras. (Patrón Decorator)</p>

    <div class="row mt-4">
        @foreach (var producto in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100">


                    @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                    {
                        <img src="@producto.ImagenUrl"
                             class="card-img-top"
                             alt="@producto.Nombre"
                             style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
              
                        <div class="text-center p-5 bg-light" style="height: 200px;">
                            <i class="fas fa-utensils fa-3x text-secondary"></i>
                            <p class="mt-2 text-muted">Sin imagen disponible</p>
                        </div>
                    }
                   

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-danger">@producto.Nombre</h5>
                        <p class="card-text text-muted">@producto.Descripcion</p>
                        <p class="card-text"><strong>Precio Base: $@producto.Precio.ToString("N2")</strong></p>

                        <form asp-action="AddToCart" method="post" class="mt-auto">
                            <input type="hidden" name="idProducto" value="@producto.IdProducto" />
                            <div class="form-group mb-3">
                                <label for="cantidad_@producto.IdProducto" class="form-label">Cantidad:</label>
                                <input id="cantidad_@producto.IdProducto" type="number" name="cantidad" value="1" min="1" class="form-control form-control-sm" required />
                            </div>

                            @if (producto.IdCategoria == 1) 
                            {
                                <h6 class="mt-3 text-primary">Extras (Decorator):</h6>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="quesoExtra" value="true" id="queso_@producto.IdProducto">
                                    <label class="form-check-label" for="queso_@producto.IdProducto">Queso Extra ($2.00)</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="carneDoble" value="true" id="carne_@producto.IdProducto">
                                    <label class="form-check-label" for="carne_@producto.IdProducto">Carne Doble ($5.00)</label>
                                </div>
                            }
                            @if (producto.IdCategoria == 2) 
                            {
                                <div class="form-check mt-3">
                                    <input class="form-check-input" type="checkbox" name="bebidaGrande" value="true" id="bebida_@producto.IdProducto">
                                    <label class="form-check-label" for="bebida_@producto.IdProducto">Tamaño Grande ($1.50)</label>
                                </div>
                            }

                            <button type="submit" class="btn btn-primary mt-3 w-100">Añadir al Carrito</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-5">
        <a asp-action="Carrito" class="btn btn-success btn-lg">Ver Carrito</a>
    </div>
</div>