@model IEnumerable<Appetite_App.Models.Producto>

@{
    ViewData["Title"] = (string)ViewData["CategoriaNombre"];
}

<div class="container mt-4">
    <p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a Categorías
        </a>
    </p>
</div>

<div class="text-center my-4">
    <h1 class="display-4 font-weight-bold" style="color: #FF6347;">@ViewData["CategoriaNombre"]</h1>
    <p class="lead text-muted">Haz clic en un producto para seleccionar extras y añadir al carrito.</p>
</div>

<div class="container mb-5">
    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var producto in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 product-card">

                        
                        @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                        {
                            <img src="@producto.ImagenUrl"
                                 class="card-img-top"
                                 alt="@producto.Nombre"
                                 style="object-fit: cover; height: 200px;">
                        }
                        else
                        {
                            <div class="text-center d-flex align-items-center justify-content-center bg-light" style="height: 200px;">
                                <span class="text-muted">No hay imagen</span>
                            </div>
                        }
                       

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@producto.Nombre</h5>
                            <p class="card-text text-muted flex-grow-1">
                                @(producto.Descripcion.Length > 70 ? producto.Descripcion.Substring(0, 70) + "..." : producto.Descripcion)
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="h4 mb-0 text-success">
                                    $@producto.Precio.ToString("N2")
                                </span>
                            
                                <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@producto.IdProducto" class="btn btn-primary btn-sm">Seleccionar</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center">
                    No hay productos disponibles en esta categoría.
                </div>
            </div>
        }
    </div>
</div>
