@model Appetite_App.DTOs.RegistroUsuarioDTO

@{
    ViewData["Title"] = "Registro";
}

<div class="row justify-content-center">
    <div class="col-md-4 card p-4 shadow-sm">
        <h2 class="card-title text-center mb-4">Registro de Cliente</h2>

        <form asp-action="Registro">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" name="Rol" value="Cliente" />

            <div class="form-group mb-3">
                <label asp-for="Nombre" class="control-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">Email</label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="form-group mb-4">
                <label asp-for="Password" class="control-label">Contraseña</label>
                <input type="password" asp-for="Password" class="form-control" />
            </div>

            <div class="form-group mt-3 text-center">
                <input type="submit" value="Registrar" class="btn btn-success w-100" />
            </div>
        </form>

        <p class="mt-3 text-center">
            <a asp-action="Login" class="small text-muted">Volver a Iniciar Sesión</a>
        </p>
    </div>
</div>