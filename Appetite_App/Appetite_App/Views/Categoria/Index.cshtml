@model IEnumerable<Appetite_App.Models.Categoria>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestión de Categorías</h1>
        <!-- Botón de Retroceso al Panel Principal Admin -->
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Volver al Panel
        </a>
    </div>

    <p>
        <a asp-action="Crear" class="btn btn-primary">
            <i class="fas fa-plus-circle"></i> Crear Nueva Categoría
        </a>
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead class="thead-dark">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.IdCategoria)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Nombre)
                    </th>
                    <th>
                        Imagen
                    </th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.IdCategoria)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Nombre)
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImagenUrl))
                            {
                                <!-- Muestra la imagen. Nota: El tamaño es solo para la tabla. -->
                                <img src="@item.ImagenUrl" alt="Imagen de @item.Nombre" style="width: 75px; height: 75px; object-fit: cover; border-radius: 4px;" />
                            }
                            else
                            {
                                <span class="text-muted">Sin imagen</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Editar" asp-route-id="@item.IdCategoria" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i> Editar
                            </a>

                            <!-- Botón de Eliminar con formulario POST por seguridad -->
                            <form asp-action="Eliminar" asp-route-id="@item.IdCategoria" method="post" style="display:inline;" onsubmit="return confirm('¿Está seguro de que desea eliminar la categoría @item.Nombre?');">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
