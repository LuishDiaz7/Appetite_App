@model Appetite_App.Models.Producto
@{
    ViewData["Title"] = "Crear Producto";
}

<h2 class="mb-4">➕ Crear Nuevo Producto</h2>

<div class="card">
    <div class="card-body">
        <form method="post" asp-action="CrearProducto">
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input type="text" name="Nombre" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <textarea name="Descripcion" class="form-control" rows="3"></textarea>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Precio</label>
                    <input type="number" name="Precio" class="form-control" step="0.01" required />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Stock</label>
                    <input type="number" name="Stock" class="form-control" required />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Categoría</label>
                    <select name="CategoriaId" class="form-control" required>
                        <option value="">Seleccione...</option>
                        @foreach (var cat in ViewBag.Categorias)
                        {
                            <option value="@cat.IdCategoria">@cat.Nombre</option>
                        }
                    </select>
                </div>
            </div>
            <div class="d-flex justify-content-between">
                <a asp-action="Productos" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger">Guardar Producto</button>
            </div>
        </form>
    </div>
</div>