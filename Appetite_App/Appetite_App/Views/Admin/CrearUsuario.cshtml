@{
    ViewData["Title"] = "Crear Usuario";
}

<h2 class="mb-4">➕ Crear Nuevo Usuario (Factory Method)</h2>

<div class="card">
    <div class="card-body">
        <form method="post" asp-action="CrearUsuario">
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input type="text" name="Nombre" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="Email" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Teléfono</label>
                <input type="tel" name="Telefono" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="password" name="Contrasena" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Rol (Factory Method)</label>
                <select name="Rol" class="form-control" required>
                    <option value="">Seleccione...</option>
                    <option value="Cliente">Cliente</option>
                    <option value="Administrador">Administrador</option>
                </select>
                <small class="text-muted">El patrón Factory Method creará el rol correspondiente</small>
            </div>
            <div class="d-flex justify-content-between">
                <a asp-action="Usuarios" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-success">Guardar Usuario</button>
            </div>
        </form>
    </div>
</div>
