@model IEnumerable<Appetite_App.Models.Categoria>
@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>📁 Gestión de Categorías</h2>
    <a asp-action="CrearCategoria" class="btn btn-primary">+ Nueva Categoría</a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var categoria in Model)
                {
                    <tr>
                        <td>@categoria.IdCategoria</td>
                        <td>@categoria.Nombre</td>
                        <td>
                            <form method="post" asp-action="EliminarCategoria" asp-route-id="@categoria.IdCategoria" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar esta categoría?')">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>