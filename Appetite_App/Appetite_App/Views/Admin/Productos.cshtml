@model IEnumerable<Appetite_App.Models.Producto>
@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="mb-4">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Volver al Panel
        </a>
    </div>
    <h2>🍔 Gestión de Productos</h2>
    <a asp-action="CrearProducto" class="btn btn-danger">+ Nuevo Producto</a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Categoría</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.IdProducto</td>
                        <td>@producto.Nombre</td>
                        <td>@producto.Descripcion</td>
                        <td>$@producto.Precio.ToString("N0")</td>
                        <td>@producto.Stock</td>
                        <td>@producto.Categoria?.Nombre</td>
                        <td>
                            <a asp-action="EditarProducto" asp-route-id="@producto.IdProducto" class="btn btn-sm btn-warning">Editar</a>
                            <form method="post" asp-action="EliminarProducto" asp-route-id="@producto.IdProducto" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar este producto?')">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>